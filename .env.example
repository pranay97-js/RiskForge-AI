# RiskForge AI Environment Configuration

# Application Mode: development / staging / production
ENVIRONMENT=development

# Optional LLM Grounded Case Explanation Provider (OpenAI / Anthropic / Gemini / Mock)
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# Cost Model Assumptions (Demo defaults in INR)
DEFAULT_INVESTIGATION_COST_INR=50.0
DEFAULT_CHARGEBACK_PENALTY_INR=3000.0

# Random Seed for Reproducibility
RANDOM_SEED=42
